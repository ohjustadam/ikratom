# Copy this file to .env.local and fill in values.

# Supabase (from your iKratom Supabase project — Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LegiScan (legiscan.com — free 30k queries/month)
LEGISCAN_API_KEY=

# OpenStates (openstates.org — free)
OPENSTATES_API_KEY=

# (Google Civic Information API was sunset in 2025 — replaced with US Census Geocoder, no key required)

# 5 Calls Representatives API (free) — OPTIONAL, non-grounded STATE/FEDERAL officials
# by location (US House/Senate, Governor, AG, SoS, state legislators) with phone +
# party. Request a free token via apidocs.5calls.org/representatives, then paste it
# here. DORMANT until set — scripts/lib/5calls-officials.mjs no-ops without it.
# NOTE: does NOT return city/county officials (those still use Legistar + Gemini
# grounding) — this is the state/federal layer (e.g. AG/Governor ban decision-makers).
FIVECALLS_TOKEN=

# Gemini (free tier, 1M tokens/day) — for AI-suggest local officials + grounded research
# Get key at aistudio.google.com → Get API key
GEMINI_API_KEY=
# Optional extra free Gemini keys for grounded-search ROTATION. Grounded
# Google-Search throttles at ~6–10 calls/day PER PROJECT; each extra key
# from a separate GCP project adds its own free quota (no billing needed),
# multiplying the daily grounded ceiling at $0. Add as many as you make.
# (Either number them _2.._9, or set the comma-list GEMINI_API_KEYS.)
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# GEMINI_API_KEYS=key1,key2,key3

# Groq Cloud (free tier, 30 RPM, 14400/day) — fast OSS inference, fallback for AI router
# Get key at console.groq.com → API Keys
GROQ_API_KEY=

# Cerebras Inference (free tier, 30 RPM, 1M tokens/day) — third cloud
# provider in the AI router rotation. Adds redundancy when Groq +
# Gemini both rate-limit during large batch runs (news classifier,
# bill-journey backfill). Get key at inference.cerebras.ai → API Keys.
CEREBRAS_API_KEY=

# Ollama local server — defaults to http://127.0.0.1:11434
# Set OLLAMA_DEFAULT_MODEL to override (default: llama3.1:8b)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_DEFAULT_MODEL=llama3.1:8b
# NOTE: the batch AI router (scripts/lib/ai-router.mjs) reads OLLAMA_URL.
# OLLAMA_URL=http://localhost:11434
# CPU throttle: every Ollama call caps inference threads to half the cores so
# nightly jobs never peg the box at 100%. Override per-run if needed.
# OLLAMA_NUM_THREAD=8
# Model the batch ai-router uses for its Ollama leg (default llama3.3:70b).
# Set to a model that fits in RAM (e.g. hermes3:8b) to keep extraction local.
# OLLAMA_ROUTER_MODEL=hermes3:8b

# SearXNG — self-hosted, keyless metasearch that FINDS a locality's official
# .gov roster page for the long-tail (non-Legistar) officials extractor. This
# is the de-Gemini replacement for Google-Search grounding
# (private/LOCAL_REPS_DEGEMINI_PLAN.md, deploy: docs/SEARXNG_DEPLOY.md). Set on
# the machine running the officials batch (owner box / self-hosted runner).
# Unset = the long tail is queued, NEVER falls back to Gemini. No API key ever.
# SEARXNG_URL=http://localhost:8080

# Tavily (tavily.com — free tier ~1,000 searches/month) — CLOUD web search that
# finds a locality's official .gov roster for off-Legistar officials WITHOUT the
# owner's box: the cloud-reachable complement to SearXNG. Unblocks the admin
# "AI suggest" tool + a cloud nightly drain of the local-rep request queue.
# Get a free key at app.tavily.com → API Keys. Unset = behaves as today (box-only).
TAVILY_API_KEY=

# (Removed 2026-05-24: ANTHROPIC_API_KEY. Platform is free-tier-only by
# policy — the AI router explicitly disables `claude` (see
# src/lib/ai/router.ts) so no code path can call Anthropic. Never re-add.)

# Google OAuth — Gmail send-on-behalf (true one-click batch sending)
# Create at console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3001/api/oauth/google/callback (dev)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Discord OAuth — Phase 2 "Sign in with Discord" + account linking.
# Create at discord.com/developers/applications → New Application →
# OAuth2 → Redirects: add http://localhost:3001/api/oauth/discord/callback
# AND https://www.ikratom.org/api/oauth/discord/callback.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# Public app URL — used for OAuth redirect, partner kit QR codes, email links.
# Dev default; production sets this to https://ikratom.org via Vercel env.
APP_URL=http://localhost:3001

# Multi-provider transactional email — router in src/lib/email/router.ts
# tries each in priority order (Brevo → Mailjet → Resend → MailerSend),
# falling back when one is rate-limited. Combined free cap ~700/day.
# Each provider's domain must be verified via DNS before sends work.

# Resend (resend.com) — 100/day, 3,000/month
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@ikratom.org
RESEND_FROM_NAME=iKratom

# Brevo / Sendinblue (brevo.com) — 300/day, highest free cap
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

# Mailjet (mailjet.com) — 200/day. Auth needs both key + secret.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=

# MailerSend (mailersend.com) — ~100/day, 3,000/month
MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=
MAILERSEND_FROM_NAME=

# Vercel Cron secret — protects /api/cron/* from random callers.
# Generate with: openssl rand -hex 32
# Set the SAME value in Vercel project env vars (production scope).
CRON_SECRET=

# GitHub dispatch token — lets the admin "Resolve queue now" button on
# /admin/local-rep-requests trigger the cloud resolution workflow
# (.github/workflows/cron-localreps-cloud.yml) on demand. WITHOUT it the button
# shows a friendly "not configured" message; the 6-hourly schedule still runs.
# Create a FINE-GRAINED PAT (github.com/settings/personal-access-tokens/new):
#   Resource owner: ohjustadam · Repository access: Only select → ikratom
#   Permissions → Repository → Actions: Read and write (that ONE permission).
# Set in Vercel project env (production, server-side — NOT NEXT_PUBLIC).
GITHUB_DISPATCH_TOKEN=
# Optional override; defaults to ohjustadam/ikratom.
GITHUB_DISPATCH_REPO=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Public key is exposed to the browser; private key MUST stay server-side.
# Required for /account → "Enable push notifications" to work.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cloudflare R2 (S3-compatible) — enables in-app advocacy video uploads.
# If unset, the UI gracefully falls back to URL-only video links.
# Setup: Cloudflare dashboard → R2 → create bucket (e.g. ikratom-media),
# create an API token with R2 read/write scope, set a public-access
# custom domain or use the pub-XXXXXX.r2.dev URL the bucket gives you.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ikratom-media
R2_PUBLIC_BASE_URL=

# CSP enforcement toggle. Default behavior (unset or anything other
# than "enforce") = Content-Security-Policy-Report-Only header. Set
# to "enforce" once you've watched browser console for violations
# and are confident no page is broken by the policy.
CSP_MODE=
