# Copy this file to .env.local and fill in values.
#
# This repo is PUBLIC: names and comments only, never real values.
#
# Conventions:
#   NAME=      a key or secret you fill in. Blank = unset; every key below is
#              optional unless its comment says REQUIRED.
#   # NAME=    a tuning knob or model override that HAS a built-in default.
#              Uncomment only to override: a blank NAME= would beat the
#              default (`process.env.X ?? "default"`), not fall back to it.
#
# Cloud jobs read GitHub Actions secrets, not this file: set the same names
# there (docs/AI_PROVIDERS.md lists where). Production site env lives in the
# Netlify dashboard. A final block lists the names the platform/CI provides.

# Supabase (from your iKratom Supabase project — Settings → API) — REQUIRED
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Management-API token (supabase.com/dashboard/account/tokens) — used by
# `npm run db:push`, the DB snapshot/backup scripts and the operator console.
SUPABASE_ACCESS_TOKEN=
# Defaults to the ref in NEXT_PUBLIC_SUPABASE_URL; set only to point scripts at
# a different project.
# SUPABASE_PROJECT_REF=
# Direct Postgres connection string — only scripts/db-backup.mjs needs it.
SUPABASE_DB_URL=
# One-off project migration (scripts/migrate-supabase-project.mjs): the NEW project's ref.
# MIGRATE_TARGET_REF=

# LegiScan (legiscan.com — free 30k queries/month)
LEGISCAN_API_KEY=

# OpenStates (openstates.org — free). API throttles per KEY (~250/day).
OPENSTATES_API_KEY=
# Hard cap on API calls per sync-bills run (also --max-requests).
# OPENSTATES_MAX_REQUESTS=

# (Google Civic Information API was sunset in 2025 — replaced with US Census Geocoder, no key required)
# Optional Census Bureau key (api.census.gov/data/key_signup.html) for higher
# rate limits on place classification; the geocoder itself needs none.
CENSUS_API_KEY=

# 5 Calls Representatives API (free) — OPTIONAL, non-grounded STATE/FEDERAL officials
# by location (US House/Senate, Governor, AG, SoS, state legislators) with phone +
# party. Request a free token via apidocs.5calls.org/representatives, then paste it
# here. DORMANT until set — scripts/lib/5calls-officials.mjs no-ops without it.
# NOTE: does NOT return city/county officials (those still use Legistar + Gemini
# grounding) — this is the state/federal layer (e.g. AG/Governor ban decision-makers).
FIVECALLS_TOKEN=

# More free data keys (all OPTIONAL — each script runs keyless or skips without it)
# NCBI / PubMed E-utilities (ncbi.nlm.nih.gov/account/settings) — higher research-sync rate limit.
NCBI_API_KEY=
# OpenFEC (api.open.fec.gov/developers) — legislator donor sync (scripts/sync-legislator-donors.mjs).
OPENFEC_API_KEY=
# Regulations.gov (open.gsa.gov/api/regulationsgov) — federal rulemaking sync. Falls back
# to the shared DEMO_KEY (heavily rate-limited) when unset.
REGULATIONS_GOV_API_KEY=

# --- AI router (free tiers only; docs/AI_PROVIDERS.md is the full list) ------
# scripts/lib/ai-router.mjs auto-adds every provider whose key is set; a provider
# without a key is skipped silently. No code path may depend on a paid AI API.

# Gemini (free tier) — AI-suggest local officials + the ONLY free grounded web search.
# Get key at aistudio.google.com → Get API key. The key's Google project must have
# NO billing linked (a billed project answers 402 "prepayment credits are depleted").
GEMINI_API_KEY=
# Optional extra free Gemini keys for grounded-search ROTATION. Grounded
# Google-Search throttles at ~6–10 calls/day PER PROJECT; each extra key
# from a separate GCP project adds its own free quota (no billing needed),
# multiplying the daily grounded ceiling at $0. Add as many as you make.
# (Either number them _2.._9, or set the comma-list GEMINI_API_KEYS.)
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# GEMINI_API_KEYS=key1,key2,key3

# Groq Cloud (free tier, ~30 RPM + daily token caps) — fast OSS inference, fallback for AI router
# Get key at console.groq.com → API Keys
GROQ_API_KEY=

# Mistral (console.mistral.ai/api-keys — free plan, no card)
MISTRAL_API_KEY=

# Cerebras — LEFT THE FREE TIER (answers 402). Leave unset; the router parks it for
# hours if a key is present. Kept wired in case it returns.
CEREBRAS_API_KEY=

# --- Extra free-tier providers (OPTIONAL) -----------------------------------
# All OpenAI-compatible; the AI router (scripts/lib/ai-router.mjs) auto-adds any
# whose key is present, widening the free rotation at $0 (empty = skipped). Set
# the SAME values as GitHub Actions secrets so the cloud chassis (cron-*-cloud.yml)
# uses them too.
# SambaNova   — cloud.sambanova.ai → APIs. Fast Llama 3.3 70B, generous free tier.
SAMBANOVA_API_KEY=
# OpenRouter  — openrouter.ai → Keys. Use ":free" models (router default is one).
OPENROUTER_API_KEY=
# NVIDIA NIM  — build.nvidia.com → API keys (needs phone verification). Free credits.
NVIDIA_API_KEY=
# Cloudflare Workers AI — dash.cloudflare.com → AI → Workers AI. 10k neurons/day free.
# Needs this token AND CLOUDFLARE_ACCOUNT_ID (set in the Cloudflare block below).
CLOUDFLARE_AI_TOKEN=
# Vercel AI Gateway — last in the chain on purpose (a $5/30-day free reserve).
AI_GATEWAY_API_KEY=
# GitHub Models — github.com/settings/tokens, a PAT with NO scopes. Being retired.
#   GOTCHA: GitHub FORBIDS Actions secret names starting with GITHUB_, so the CI
#   secret MUST be named GH_MODELS_TOKEN. Locally either name works (router reads
#   GITHUB_MODELS_TOKEN || GH_MODELS_TOKEN). Set GH_MODELS_TOKEN as the GH secret.
GITHUB_MODELS_TOKEN=
GH_MODELS_TOKEN=

# Router tuning (all have defaults)
# Force the provider try-order, e.g. groq,gemini,mistral
# AI_PROVIDER_ORDER=
# Longest the router waits on one rate-limited provider, and its total wait budget (ms).
# AI_ROUTER_MAX_WAIT_MS=
# AI_ROUTER_WAIT_BUDGET_MS=
# Per-provider model overrides (the router and tool-chat have a default for each):
# GEMINI_MODEL=
# GEMINI_DEFAULT_MODEL=
# GROQ_MODEL=
# GROQ_DEFAULT_MODEL=
# MISTRAL_MODEL=
# CEREBRAS_MODEL=
# SAMBANOVA_MODEL=
# OPENROUTER_MODEL=
# NVIDIA_MODEL=
# GITHUB_MODELS_MODEL=
# CLOUDFLARE_AI_MODEL=
# VERCEL_AI_MODEL=
# Per-job provider pin (default ollama or groq depending on the job; any router provider name):
# BAN_EXTRACT_PROVIDER=
# MEETING_EXTRACT_PROVIDER=
# OFFICIALS_EXTRACT_PROVIDER=
# STANCE_RESEARCH_PROVIDER=

# Embeddings (scripts/lib/embed-router.mjs; scripts/compute-bill-embeddings.mjs)
# EMBED_PROVIDER=
# EMBED_DIMS=
# CLOUDFLARE_EMBED_MODEL=
# GEMINI_EMBED_MODEL=
# OLLAMA_EMBED_MODEL=

# Ollama local server — defaults to http://127.0.0.1:11434
# Set OLLAMA_DEFAULT_MODEL to override (default: llama3.1:8b)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_DEFAULT_MODEL=llama3.1:8b
# NOTE: the batch AI router (scripts/lib/ai-router.mjs) reads OLLAMA_URL.
# OLLAMA_URL=http://localhost:11434
# CPU throttle: every Ollama call caps inference threads to half the cores so
# nightly jobs never peg the box at 100%. Override per-run if needed.
# OLLAMA_NUM_THREAD=8
# Model the batch ai-router uses for its Ollama leg (default llama3.3:70b).
# Set to a model that fits in RAM (e.g. hermes3:8b) to keep extraction local.
# OLLAMA_ROUTER_MODEL=hermes3:8b
# Model for tool-calling chat (scripts/lib/tool-chat.mjs, research-campaign.mjs).
# OLLAMA_TOOL_MODEL=

# Text-to-speech weights precision for scripts/lib/kokoro-tts.mjs (fp32 is the safe default).
# KOKORO_DTYPE=
# Set to 0 to disable the headless-Chromium page renderer (scripts/lib/headless-render.mjs).
# HEADLESS_RENDER=

# SearXNG — self-hosted, keyless metasearch that FINDS a locality's official
# .gov roster page for the long-tail (non-Legistar) officials extractor. This
# is the de-Gemini replacement for Google-Search grounding
# (private/LOCAL_REPS_DEGEMINI_PLAN.md, deploy: docs/SEARXNG_DEPLOY.md). Set on
# the machine running the officials batch (owner box / self-hosted runner).
# Unset = the long tail is queued, NEVER falls back to Gemini. No API key ever.
# SEARXNG_URL=http://localhost:8080

# Tavily (tavily.com — free tier ~1,000 searches/month) — CLOUD web search that
# finds a locality's official .gov roster for off-Legistar officials WITHOUT the
# owner's box: the cloud-reachable complement to SearXNG. Unblocks the admin
# "AI suggest" tool + a cloud nightly drain of the local-rep request queue.
# Get a free key at app.tavily.com → API Keys. Unset = behaves as today (box-only).
TAVILY_API_KEY=

# (Removed 2026-05-24: ANTHROPIC_API_KEY. Platform is free-tier-only by
# policy — the AI router explicitly disables `claude` (see
# src/lib/ai/router.ts) so no code path can call Anthropic. Never re-add.)

# Google OAuth — Gmail send-on-behalf (true one-click batch sending)
# Create at console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3001/api/oauth/google/callback (dev)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft OAuth — Outlook send-on-behalf (the Gmail flow's twin).
# Create at portal.azure.com → App registrations. Redirect URI:
# http://localhost:3001/api/oauth/outlook/callback (dev) and the www.ikratom.org one.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Discord OAuth — Phase 2 "Sign in with Discord" + account linking.
# Create at discord.com/developers/applications → New Application →
# OAuth2 → Redirects: add http://localhost:3001/api/oauth/discord/callback
# AND https://www.ikratom.org/api/oauth/discord/callback.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# Public app URL — used for OAuth redirect, partner kit QR codes, email links.
# Dev default; production sets this to https://www.ikratom.org via the Netlify env.
APP_URL=http://localhost:3001
# Scripts fall back to this when APP_URL is unset (links in forum posts, broadcasts).
# NEXT_PUBLIC_APP_URL=
# Base URL for links in notification emails (scripts/send-email-notifications.mjs);
# falls back to APP_URL, then NEXT_PUBLIC_APP_URL, then production.
# EMAIL_APP_URL=

# Multi-provider transactional email — router in src/lib/email/router.ts
# tries each in priority order (Brevo → Mailjet → Resend → MailerSend),
# falling back when one is rate-limited. Combined free cap ~700/day.
# Each provider's domain must be verified via DNS before sends work.
# The commented *_FROM_EMAIL / *_FROM_NAME lines fall back to RESEND_FROM_*.
# Uncomment one only to give that provider its own sender: a blank value would
# override the fallback and send with an empty From.

# Resend (resend.com) — 100/day, 3,000/month
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@ikratom.org
RESEND_FROM_NAME=iKratom

# Brevo / Sendinblue (brevo.com) — 300/day, highest free cap
BREVO_API_KEY=
# BREVO_FROM_EMAIL=
# BREVO_FROM_NAME=

# Mailjet (mailjet.com) — 200/day. Auth needs both key + secret.
MAILJET_API_KEY=
MAILJET_API_SECRET=
# MAILJET_FROM_EMAIL=
# MAILJET_FROM_NAME=

# MailerSend (mailersend.com) — ~100/day, 3,000/month
MAILERSEND_API_KEY=
# MAILERSEND_FROM_EMAIL=
# MAILERSEND_FROM_NAME=

# Sender for the cron scripts' mail (scripts/lib/email-send.mjs); falls back to RESEND_FROM_*.
# EMAIL_FROM=
# EMAIL_FROM_NAME=

# Owner alerts (scripts/lib/owner-alert.mjs) — how the platform reaches the owner
# when something needs a human. Any subset works; all unset = no alert.
# ntfy.sh push: pick a hard-to-guess topic, subscribe in the ntfy app.
NTFY_TOPIC=
# Self-hosted ntfy server (default is the public ntfy.sh).
# NTFY_SERVER=
# The owner's own address: where feedback and ops alerts are emailed. Never commit a real one.
OWNER_EMAIL=
# Carrier email-to-SMS gateway address for a one-line text (e.g. 5551234567@<carrier gateway>).
OWNER_SMS_EMAIL=

# Cron secret — protects /api/cron/* from random callers. GitHub Actions
# workflows send it as a Bearer token; set the SAME value as the GitHub secret
# CRON_SECRET and in the Netlify env. Generate with: openssl rand -hex 32
CRON_SECRET=

# GitHub dispatch token — lets the admin "Resolve queue now" button on
# /admin/local-rep-requests trigger the cloud resolution workflow
# (.github/workflows/cron-localreps-cloud.yml) on demand. WITHOUT it the button
# shows a friendly "not configured" message; the 6-hourly schedule still runs.
# Create a FINE-GRAINED PAT (github.com/settings/personal-access-tokens/new):
#   Resource owner: ohjustadam · Repository access: Only select → ikratom
#   Permissions → Repository → Actions: Read and write (that ONE permission).
# Set in the Netlify env (production, server-side — NOT NEXT_PUBLIC).
GITHUB_DISPATCH_TOKEN=
# Optional override; defaults to ohjustadam/ikratom.
GITHUB_DISPATCH_REPO=
# Local operator console (desktop/operator, `npm run operator`): a GitHub token
# for its Actions/PR panels, and the repo it targets (defaults to this one).
# GITHUB_TOKEN=
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=
# Operator console listen port (127.0.0.1 only) and a fixed UI token; the token is
# random per launch when unset, which is what you want.
# OPERATOR_PORT=
# OPERATOR_TOKEN=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Public key is exposed to the browser; private key MUST stay server-side.
# Required for /account → "Enable push notifications" to work.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Older alias for NEXT_PUBLIC_VAPID_PUBLIC_KEY, read by scripts/check-cron-staleness.mjs.
# VAPID_PUBLIC_KEY=

# Cloudflare R2 (S3-compatible) — enables in-app advocacy video uploads.
# If unset, the UI gracefully falls back to URL-only video links.
# Setup: Cloudflare dashboard → R2 → create bucket (e.g. ikratom-media),
# create an API token with R2 read/write scope, set a public-access
# custom domain or use the pub-XXXXXX.r2.dev URL the bucket gives you.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ikratom-media
R2_PUBLIC_BASE_URL=

# Cloudflare account — shared by Workers AI (above), the R2 stores below and the
# Cloudflare scripts. Dashboard → right sidebar "Account ID".
CLOUDFLARE_ACCOUNT_ID=
# Deploy token: the site derives R2 credentials from it (access key = token id,
# secret = sha256(token)) for the snapshot and member-media stores below, so they
# need no separate R2 keys. Also used to deploy the send-record worker.
CLOUDFLARE_DEPLOY_TOKEN=
# Public-page snapshot store (src/lib/public-snapshots.ts): serves the last good copy
# of a page's data when Supabase is unreachable. OFF unless SNAPSHOTS_R2=on AND a prefix is set.
# SNAPSHOTS_R2=on
# SNAPSHOT_R2_PREFIX=
# SNAPSHOT_R2_BUCKET=
# Optional bucket-scoped R2 token instead of the derived credentials:
# SNAPSHOT_R2_ACCESS_KEY_ID=
# SNAPSHOT_R2_SECRET_ACCESS_KEY=
# Member photo/media store (src/lib/media-store.ts): same derived-credential rule.
# MEDIA_R2_BUCKET=
# MEDIA_R2_ACCESS_KEY_ID=
# MEDIA_R2_SECRET_ACCESS_KEY=
# Cloudflare ops scripts (cache rules, origin report, email worker). Scoped tokens:
# CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CACHE_TOKEN=
CLOUDFLARE_EMAIL_TOKEN=
# CLOUDFLARE_ZONE_ID=

# Site hosting + usage watchdog (scripts/check-vercel-usage.mjs, netlify-credit-gate.mjs).
# Production is on Netlify; Vercel is a paused cold spare (STATE_OF_PLAY.md).
# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=
# NETLIFY_ACCOUNT_SLUG=
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# HOST_PLATFORM=netlify
# Site the watchdog probes (defaults to production).
# WATCHDOG_SITE_URL=
# Flood thresholds per hour: requests from one IP, origin requests, origin seconds.
# FLOOD_IP_PER_HOUR=
# FLOOD_ORIGIN_REQ_PER_HOUR=
# FLOOD_ORIGIN_SEC_PER_HOUR=
# Replay a past hour for testing the watchdog (ISO timestamp).
# WATCHDOG_AS_OF=

# Monitoring. All optional; each is off until its key is set.
# PostHog product analytics (browser): project key + ingestion host.
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# Sentry error capture: DSN for the server/edge runtimes and for the browser.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Sentry source-map upload at build time (needs all three).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# CSP enforcement toggle. Default behavior (unset or anything other
# than "enforce") = Content-Security-Policy-Report-Only header. Set
# to "enforce" once you've watched browser console for violations
# and are confident no page is broken by the policy.
CSP_MODE=

# --- Misc and developer tooling (all OPTIONAL) -------------------------------
# Facebook app access token so a meeting broadcast can refresh the share preview
# (scripts/broadcast-meeting-cli.mjs); without it the script just pre-warms the cache.
FB_APP_ACCESS_TOKEN=
# Where an in-app Android install button points to a signed APK, if you host one.
# IKRATOM_APK_URL=
# Cap on meetings the discovery job may auto-publish per run (default 5).
# MEETING_AUTOPUBLISH_MAX_PER_RUN=
# Folder `npm run backups` pulls DB snapshots into (a sensible per-OS default exists).
# BACKUP_DIR=
# Send-queue end-to-end tests (scripts/test-send-queue-*.mjs): an inbox you own, and
# the dev server to hit.
# AUDIT_TEST_EMAIL=
# TEST_BASE_URL=
# Responsive-guard script (scripts/check-responsive.mjs): server to test and widths to try.
# BASE_URL=
# WIDTHS=
# Session mesh (scripts/session-mesh.mjs): shared-journal folder override, and a switch
# to stop it calling GitHub.
# SESSION_MESH_DIR=
# SESSION_MESH_OFFLINE=

# --- Provided by the platform or CI: do NOT set by hand ---------------------
# NODE_ENV, NEXT_RUNTIME, CI, TZ, DEBUG, GITHUB_ACTIONS, GITHUB_OUTPUT,
# GITHUB_STEP_SUMMARY. The code reads them, but Next.js, Node or the CI runner
# sets them.

# ── Sturdier AI router (2026-10-27, docs/AI_PROVIDERS.md "Extra slots") ──────
# Any free OpenAI-compatible host joins the pool with env alone (n = 1..5).
# _KEY may be blank for keyless hosts. _NAME is a short slug used in logs.
# AI_EXTRA_1_NAME=
# AI_EXTRA_1_URL=            # e.g. https://api.example.ai/v1
# AI_EXTRA_1_MODEL=
# AI_EXTRA_1_KEY=
# Default model tier when a caller doesn't pass one: large (default) | small.
# AI_TIER_DEFAULT=large
# Smaller sibling models for tier "small" (defaults: groq openai/gpt-oss-20b).
# GROQ_MODEL_SMALL=
# MISTRAL_MODEL_SMALL=
# Shared provider health + response cache (mig 0297). 0 turns both off.
# AI_ROUTER_PERSIST=1
# Override the health scope (gha | site | local) if auto-detection is wrong.
# AI_ROUTER_SCOPE=
