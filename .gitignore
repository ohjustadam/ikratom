# Secrets. `.env*` is deliberately broad — `.env*.local` did NOT match sidecar
# files like `.env.local.bak-20260722`, which is exactly how a service-role key
# nearly landed in this PUBLIC repo (2026-07-22). The example file is re-allowed
# below; keep real backups OUTSIDE the repo (C:\claude\_claude-backup\).
.env*
!.env.local.example
*.log
.DS_Store
.vercel
next-env.d.ts
tsconfig.tsbuildinfo

.vercel

# Local Claude Code config (skills symlinks, preview launch.json) — machine-specific
.claude/
private/

# Gazetteer: raw Census downloads + transient audit dumps. Only the built
# us-counties.json / us-places.json are committed (regenerate via build-gazetteer.mjs).
scripts/lib/geo/_raw/
scripts/lib/geo/_proposed.json
scripts/lib/geo/_confirmed.json
# One-off diagnostic/fix scripts (underscore-prefixed, never committed)
scripts/_*.mjs
# Sensitive commits held out of auto-generated changelog drafts (review sidecar,
# written by scripts/generate-patch-note.mjs — never published, never committed)
src/content/patch-notes/*.held.txt
.playwright-mcp/
desktop/src-tauri/target/
desktop/src-tauri/icons/
desktop/src-tauri/Cargo.lock
desktop/src-tauri/gen/

# Netlify build artifacts (generated by `netlify deploy --build`)
.netlify/
deno.lock
