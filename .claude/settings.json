{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/session-mesh.mjs\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/session-mesh.mjs\" prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "input=$(cat); case \"$input\" in *private*|*memory*) printf '%s' \"$input\" | node \"$CLAUDE_PROJECT_DIR/scripts/session-mesh.mjs\" pre-edit;; esac",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "async": true,
            "command": "input=$(cat); case \"$input\" in *'pr merge'*|*'pr create'*|*commit*|*merge-loop*|*netlify.com*|*db:push*) printf '%s' \"$input\" | node \"$CLAUDE_PROJECT_DIR/scripts/session-mesh.mjs\" post-bash;; esac",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/session-mesh.mjs\" session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
